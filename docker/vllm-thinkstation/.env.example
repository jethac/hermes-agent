# Copy to .env and edit locally:
#   cp .env.example .env
#
# Keep this file committed; keep .env private.

# Base image. Pin this after the first known-good ThinkStation build.
VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_IMAGE_TAG=latest

# Required for gated Hugging Face checkpoints.
HF_TOKEN=

# Host cache locations. These keep model downloads outside the container while
# keeping Python/CUDA experiments isolated inside Docker.
HF_HOME=${HOME}/.cache/huggingface
VLLM_CACHE_DIR=./.vllm-cache

# Shared runtime knobs.
VLLM_SHM_SIZE=32g
VLLM_WORKER_MULTIPROC_METHOD=spawn
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
NCCL_DEBUG=WARN

# Reflex endpoint: Gemma 4 E2B. The Google official checkpoint is the default.
# A community NVFP4 checkpoint was tested with vLLM 0.24.0 on the PGX host and
# failed during tied-weight initialization, so keep NVFP4 as an explicit
# experiment rather than the bring-up default.
GEMMA4_E2B_PORT=8001
GEMMA4_E2B_MODEL=google/gemma-4-E2B-it
GEMMA4_E2B_SERVED_NAME=gemma-4-e2b-reflex
GEMMA4_E2B_MAX_MODEL_LEN=8192
GEMMA4_E2B_GPU_MEMORY_UTILIZATION=0.12
GEMMA4_E2B_LIMIT_MM_PER_PROMPT={"audio":1,"image":0,"video":0}
GEMMA4_E2B_EXTRA_ARGS=

# Primary local oracle: Gemma 4 12B Unified multimodal.
GEMMA4_12B_PORT=8002
GEMMA4_12B_MODEL=google/gemma-4-12B-it
GEMMA4_12B_SERVED_NAME=gemma-4-12b-oracle
GEMMA4_12B_MAX_MODEL_LEN=65536
GEMMA4_12B_GPU_MEMORY_UTILIZATION=0.38
GEMMA4_12B_LIMIT_MM_PER_PROMPT={"audio":1,"image":1,"video":0}
GEMMA4_12B_EXTRA_ARGS=--max-num-seqs 4 --enforce-eager --enable-auto-tool-choice --tool-call-parser hermes

# Secondary local oracle: official NVIDIA Nemotron 3 Nano 30B-A3B NVFP4.
NEMOTRON_NANO_PORT=8003
NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4
NEMOTRON_NANO_SERVED_NAME=nemotron-3-nano-oracle
NEMOTRON_NANO_MAX_MODEL_LEN=65536
NEMOTRON_NANO_GPU_MEMORY_UTILIZATION=0.28
NEMOTRON_NANO_TENSOR_PARALLEL_SIZE=1
NEMOTRON_NANO_EXTRA_ARGS=--max-num-seqs 4 --enforce-eager --enable-auto-tool-choice --tool-call-parser hermes --reasoning-parser nemotron_v3

# Optional deep local oracle: official NVIDIA Nemotron 3 Super NVFP4.
NEMOTRON_SUPER_PORT=8004
NEMOTRON_SUPER_MODEL=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4
NEMOTRON_SUPER_SERVED_NAME=nemotron-3-super-oracle
NEMOTRON_SUPER_MAX_MODEL_LEN=65536
NEMOTRON_SUPER_GPU_MEMORY_UTILIZATION=0.62
NEMOTRON_SUPER_TENSOR_PARALLEL_SIZE=1
NEMOTRON_SUPER_EXTRA_ARGS=--max-num-seqs 4 --enforce-eager --enable-auto-tool-choice --tool-call-parser hermes --reasoning-parser nemotron_v3
