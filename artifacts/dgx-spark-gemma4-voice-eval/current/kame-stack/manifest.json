{
  "artifacts": {
    "benchmark_evidence_template": "benchmark-evidence-template.json",
    "benchmark_matrix": "benchmark-matrix.json",
    "benchmark_validation": "validate-benchmark-evidence.sh",
    "compose": "compose.yaml",
    "env_example": ".env.example",
    "launch": "launch-local-stack.sh",
    "preflight": "preflight.json",
    "preflight_script": "preflight-local-stack.sh"
  },
  "barge_in": {
    "min_rms": 350,
    "min_speech_ms": 120,
    "stop_playback_deadline_ms": 150
  },
  "engine": {
    "asr_mode": "on_escalation",
    "durability_policy": "commit final intents and oracle results only",
    "fallback_policy": "legacy_voice",
    "interface_audio_input": "native_audio",
    "max_spoken_sentences": 2,
    "name": "kame_interface_oracle",
    "voice_response_policy": "sentence_cap"
  },
  "evidence_required": [
    "interface_direct_audio_latency",
    "oracle_simple_first_audio_latency",
    "interface_candidate_model_matrix",
    "interface_direct_audio_vs_stt_fallback",
    "oracle_verbatim_asr_latency_and_literal_accuracy",
    "local_asr_tts_benchmark_matrix",
    "all_local_smoke",
    "cloud_fallback_smoke",
    "capability_honesty_smoke",
    "barge_in_interruption_smoke"
  ],
  "hermes_home": "/Users/jethac/.hermes",
  "images": {
    "hermes": "ghcr.io/astral-sh/uv:python3.12-bookworm-slim",
    "vllm": "vllm/vllm-openai:gemma4-cu130"
  },
  "kind": "kame_dgx_spark_stack",
  "metrics": {
    "enabled": true,
    "log_provider_spans": true,
    "log_turn_spans": true
  },
  "model_assumptions": {
    "interface_audio_input_supported": {
      "description": "Interface/reflex model accepts a bounded audio prompt segment and returns text JSON.",
      "model": "gemma-4-E2B-it",
      "required": true,
      "validated_by": "interface_audio_probe"
    },
    "interface_audio_is_segment_buffered": {
      "description": "Realtime endpointer cuts audio before the interface model encodes it; the model is not treated as a streaming VAD.",
      "required": true,
      "validated_by": "vad_endpoint_then_interface_audio_probe"
    },
    "interface_audio_limit_seconds": {
      "required": true,
      "seconds": 30.0,
      "validated_by": "manifest_and_vllm_limit_mm_per_prompt"
    },
    "oracle_authority": {
      "description": "Hermes active oracle or local oracle endpoint remains authoritative for tools, memory, files, and project context.",
      "model": "nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4",
      "required": true,
      "validated_by": "oracle_models_probe"
    },
    "vllm_multimodal_audio_prompt_limit": {
      "limit_mm_per_prompt": {
        "audio": 1,
        "image": 0
      },
      "required": true,
      "validated_by": "compose_vllm_args"
    },
    "vllm_oracle_text_only_multimodal_limit": {
      "description": "Oracle vLLM disables unused multimodal profiling so memory stays reserved for text-oracle work.",
      "limit_mm_per_prompt": {
        "audio": 0,
        "image": 0
      },
      "required": true,
      "validated_by": "compose_vllm_args"
    }
  },
  "quality_targets_ms": {
    "barge_in_stop": 150,
    "first_tts_audio_to_playback_start": 150,
    "local_ack_first_audio": 500,
    "local_reply_first_audio": 1000,
    "oracle_ack": 500,
    "oracle_first_token_to_first_tts_audio": 1000,
    "simple_oracle_first_audio": 3000,
    "tool_or_context_oracle_first_audio": 8000
  },
  "repo_dir": "/Volumes/MacMiniOffload/home/projects/hermes-agent/.codex-worktrees/full-kame-reflex-voice",
  "roles": {
    "asr": {
      "adapter": "loopback_smoke_bridge",
      "base_url": "http://spark.local:8767",
      "feeds_reflex": false,
      "health_url": "http://spark.local:8767/health",
      "mode": "on_escalation",
      "model": "oracle-verbatim-asr",
      "module": "hermes_cli.realtime_voice_loopback_bridge",
      "production_replacement": "local_streaming_asr",
      "protocol_smoke_only": true,
      "provider": "streaming_stt",
      "role": "oracle_verbatim_evidence"
    },
    "interface": {
      "api_key_env": "HERMES_KAME_INTERFACE_API_KEY",
      "audio_input": "native_audio",
      "base_url": "http://spark.local:8000/v1",
      "candidate_models": [
        {
          "model": "gemma-4-E2B-it",
          "priority": "default",
          "reason": "preferred_audio_reflex"
        },
        {
          "model": "gemma-4-E4B-it",
          "priority": "comparison",
          "reason": "validate_only_if_default_fails_latency_routing_or_capability_honesty"
        }
      ],
      "gpu_memory_utilization": 0.18,
      "implementation": "openai_compatible_vllm",
      "limit_mm_per_prompt": {
        "audio": 1,
        "image": 0
      },
      "max_audio_seconds": 30.0,
      "max_model_len": 8192,
      "max_output_tokens": 160,
      "model": "gemma-4-E2B-it",
      "models_url": "http://spark.local:8000/v1/models",
      "provider": "gemma4",
      "routing": [
        "local",
        "defer",
        "oracle_direct",
        "reject_or_clarify"
      ],
      "temperature": 0.2,
      "timeout_seconds": 0.8
    },
    "oracle": {
      "authority": [
        "tools",
        "memory",
        "files",
        "project_context"
      ],
      "base_url": "http://spark.local:8001/v1",
      "gpu_memory_utilization": 0.62,
      "limit_mm_per_prompt": {
        "audio": 0,
        "image": 0
      },
      "max_model_len": 32768,
      "models_url": "http://spark.local:8001/v1/models",
      "preferred_local_model": "nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4",
      "provider": "hermes_active_oracle_or_openai_compatible_vllm",
      "timeout_seconds": 60.0
    },
    "sidecar": {
      "base_url": "http://spark.local:8765",
      "health_url": "http://spark.local:8765/health",
      "module": "hermes_cli.realtime_voice_sidecar",
      "session_path": "/v1/realtime-text/session"
    },
    "tts": {
      "adapter": "loopback_smoke_bridge",
      "base_url": "http://spark.local:8768",
      "health_url": "http://spark.local:8768/health",
      "model": "local-streaming-tts",
      "module": "hermes_cli.realtime_voice_loopback_bridge",
      "production_replacement": "local_streaming_tts",
      "protocol_smoke_only": true,
      "provider": "streaming_tts",
      "role": "spoken_output"
    }
  },
  "routing": {
    "allow_local_clarifications": true,
    "allow_local_greetings": true,
    "local_confidence_threshold": 0.75,
    "require_oracle_for_files": true,
    "require_oracle_for_memory": true,
    "require_oracle_for_tools": true
  },
  "target": {
    "cloud_fallback": "configurable",
    "hardware": "1x DGX Spark",
    "mode": "headless"
  },
  "version": 1,
  "volumes": {
    "model_cache_dir": "/Users/jethac/.cache/huggingface"
  }
}
